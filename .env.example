# MongoDB Atlas. The database name is sida.
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/sida
PORT=4000

# Signs access and refresh tokens. Keep this on the server only.
JWT_SECRET=

# Optional. Used when a client signs in with Google or Apple.
GOOGLE_CLIENT_ID=
APPLE_CLIENT_ID=

# Address autocomplete on a new claim. Server only.
GOOGLE_MAPS_API_KEY=

# Cloudinary signed uploads. The API secret stays in this file, not in the Expo app.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_SECRET=
